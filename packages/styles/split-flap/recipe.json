{
  "id": "split-flap",
  "name": "Split-Flap Board",
  "families": ["reveal"],
  "energy": 3,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "flush-stack",
    "unit": "grapheme",
    "reveal": "flap",
    "motion": "snappy",
    "axis": "none",
    "material": "glow-tint",
    "background": "screen",
    "transition": "cut"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.align": 1,
    "layout.weight": 700,
    "layout.gap": 0.6,
    "layout.uniform": 1,
    "layout.dateRow": 1,
    "layout.cap": 0.22,
    "layout.leading": 0.3,
    "background.lines": 0,
    "background.vignette": 0.6,
    "background.bloom": 0.12,
    "background.sweep": 0
  },
  "signature": {
    "module": "split-flap",
    "owns": ["layout", "reveal"]
  },
  "defaults": {
    "palette": "departure-board",
    "music": { "preset": "minimal-pop", "bpm": 104 },
    "fonts": { "display": "cousine" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
        "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote", "datetime",
        "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.5,
    "minTail": 0.9,
    "entry": 0.85,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
