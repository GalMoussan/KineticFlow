{
  "id": "neon-psychedelic",
  "name": "Neon Psychedelic",
  "families": ["high-energy", "beat-synced", "generative"],
  "energy": 5,
  "background": "dark",
  "traits": {
    "rhythm": "hits",
    "camera": "shake",
    "layout": "center-stack",
    "unit": "grapheme",
    "reveal": "neon-mix",
    "motion": "punchy",
    "axis": "none",
    "material": "neon-glow",
    "background": "starfield",
    "transition": "flash-cut"
  },
  "params": {},
  "defaults": {
    "palette": "neon-night",
    "music": { "preset": "lofi-jazz", "bpm": 120 },
    "fonts": { "display": "rubik" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.15,
    "minTail": 0.6,
    "entry": 0.55,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "sketch",
    "width": 1.2,
    "rough": 0.3,
    "boil": true,
    "glow": 1,
    "drawBeats": 1,
    "ease": "snap",
    "exit": "fade",
    "pen": false,
    "color": "text",
    "layer": "over",
    "sfx": "scribble"
  }
}
