{
  "id": "typewriter-terminal",
  "name": "Typewriter Terminal",
  "families": ["reveal"],
  "energy": 2,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "flush-stack",
    "unit": "grapheme",
    "reveal": "typewriter",
    "motion": "snappy",
    "axis": "none",
    "material": "glow-tint",
    "background": "screen",
    "transition": "cut"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.align": 1,
    "layout.weight": 700,
    "layout.gap": 0.6,
    "layout.prompt": 1,
    "layout.tail": 0.7,
    "layout.cap": 0.26,
    "layout.plain": 0.72,
    "layout.leading": 0.4,
    "material.glow": 0.8,
    "background.lines": 0.6,
    "background.vignette": 0.7,
    "background.bloom": 0.25,
    "background.sweep": 0.4
  },
  "defaults": {
    "palette": "terminal-green",
    "music": { "preset": "lofi-jazz", "bpm": 100 },
    "fonts": { "display": "cousine" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
        "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote", "datetime",
        "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.45,
    "minTail": 0.9,
    "entry": 0.75,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "line",
    "width": 0.9,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 2,
    "ease": "snap",
    "exit": "undraw",
    "pen": true,
    "color": "text",
    "layer": "over",
    "sfx": "scribble"
  }
}
