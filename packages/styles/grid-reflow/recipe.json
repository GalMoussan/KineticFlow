{
  "id": "grid-reflow",
  "name": "Grid Re-flow",
  "families": ["dynamic-layout", "motion"],
  "energy": 3,
  "background": "light",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "grid-reflow",
    "unit": "word",
    "reveal": "swiss-mix",
    "motion": "snappy",
    "axis": "none",
    "material": "tile-ink",
    "background": "module-grid",
    "transition": "reflow"
  },
  "params": {
    "rhythm.kick": 0,
    "reveal.stagger": 0.035,
    "transition.whoosh": 0.4
  },
  "defaults": {
    "palette": "swiss-modern",
    "music": { "preset": "minimal-pop", "bpm": 112 },
    "fonts": { "display": "heebo" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1.5,
    "leadIn": 0.1,
    "minTail": 0.6,
    "entry": 0.6,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "sketch",
    "width": 1.2,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 1.5,
    "ease": "functional",
    "exit": "fade",
    "pen": false,
    "color": "text",
    "layer": "over",
    "sfx": "pop"
  }
}
