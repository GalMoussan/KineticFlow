{
  "id": "z-tunnel",
  "name": "Z Tunnel",
  "families": ["spatial", "high-energy"],
  "energy": 4,
  "background": "dark",
  "traits": {
    "rhythm": "land-kick",
    "camera": "fly-through",
    "layout": "center-stack",
    "unit": "word",
    "reveal": "z-arrive",
    "motion": "punchy",
    "axis": "none",
    "material": "glow-tint",
    "background": "tunnel",
    "transition": "handoff"
  },
  "params": {
    "rhythm.kick": 0.02,
    "rhythm.decay": 8,
    "layout.cap": 0.4,
    "material.glow": 0.8,
    "transition.whoosh": 0
  },
  "defaults": {
    "palette": "tunnel-night",
    "music": { "preset": "house-128", "bpm": 124 },
    "fonts": { "display": "rubik" }
  },
  "constraints": {
    "maxWordsPerSection": 5,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.2,
    "minTail": 0.6,
    "entry": 0.55,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
