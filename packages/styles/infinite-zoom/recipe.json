{
  "id": "infinite-zoom",
  "name": "Infinite Zoom",
  "families": ["spatial", "motion"],
  "energy": 4,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "droste-zoom",
    "layout": "nest-frames",
    "unit": "word",
    "reveal": "nest-show",
    "motion": "smooth",
    "axis": "none",
    "material": "glow-tint",
    "background": "plain",
    "transition": "handoff"
  },
  "params": {
    "rhythm.kick": 0,
    "material.glow": 0.35,
    "layout.nest": 0.34,
    "layout.cap": 0.82,
    "camera.nest": 0.34,
    "camera.whoosh": 0.5,
    "transition.show": 0,
    "transition.hide": 1,
    "transition.whoosh": 0
  },
  "defaults": {
    "palette": "droste-dusk",
    "music": { "preset": "synthwave-drive", "bpm": 118 },
    "fonts": { "display": "suez-one" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 0.5,
    "shortUnitBeats": 0.5,
    "moveBeats": 1.5,
    "leadIn": 0.25,
    "minTail": 0.7,
    "entry": 0.35,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "line",
    "width": 1,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 2.5,
    "ease": "smooth",
    "exit": "fade",
    "pen": false,
    "color": "text",
    "layer": "over",
    "sfx": "scribble"
  }
}
