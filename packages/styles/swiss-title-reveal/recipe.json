{
  "id": "swiss-title-reveal",
  "name": "Swiss Title Reveal",
  "families": ["reveal", "beat-synced"],
  "energy": 4,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "bauhaus-poster",
    "unit": "word",
    "reveal": "swiss-mix",
    "motion": "snappy",
    "axis": "none",
    "material": "outline-fill",
    "background": "solid-bauhaus",
    "transition": "panel-wipe"
  },
  "params": {},
  "defaults": {
    "palette": "flamingo-cafe",
    "music": { "preset": "lofi-jazz", "bpm": 120 },
    "fonts": { "display": "rubik" }
  },
  "constraints": {
    "maxWordsPerSection": 5,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.1,
    "minTail": 0.6,
    "entry": 0.6,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
