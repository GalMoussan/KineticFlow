{
  "id": "equalizer-type",
  "name": "Equalizer Type",
  "families": [
    "audio-reactive",
    "beat-synced"
  ],
  "energy": 4,
  "background": "dark",
  "traits": {
    "rhythm": "equalizer",
    "camera": "static",
    "layout": "fit-stack",
    "unit": "grapheme",
    "reveal": "bar-rise",
    "motion": "punchy",
    "axis": "none",
    "material": "spectrum",
    "background": "pulse-glow",
    "transition": "flash-cut"
  },
  "params": {
    "layout.headroom": 0.75,
    "layout.leading": 0.2,
    "layout.plain": 0.7,
    "background.glow": 0.45,
    "background.ring": 0.25,
    "transition.flash": 0.3,
    "rhythm.amp": 0.85
  },
  "defaults": {
    "palette": "spectrum",
    "music": {
      "preset": "house-128",
      "bpm": 124
    },
    "fonts": {
      "display": "rubik"
    }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": [
      "9:16",
      "1:1",
      "4:5",
      "16:9"
    ],
    "roles": [
      "title",
      "tagline",
      "body",
      "teaser",
      "cta",
      "heading",
      "question",
      "answer",
      "quote",
      "datetime",
      "location",
      "list",
      "stat",
      "countdown",
      "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.15,
    "minTail": 0.8,
    "entry": 0.55,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "sketch",
    "width": 1.2,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 1,
    "ease": "snap",
    "exit": "fade",
    "pen": false,
    "color": "accent0",
    "layer": "over",
    "sfx": "scribble"
  }
}
