{
  "id": "card-deck-3d",
  "name": "Card Deck 3D",
  "families": ["spatial", "narrative"],
  "energy": 3,
  "background": "dark",
  "traits": {
    "rhythm": "land-kick",
    "camera": "static",
    "layout": "card-deck",
    "unit": "word",
    "reveal": "kinetic-mix",
    "motion": "smooth",
    "axis": "none",
    "material": "face-ink",
    "background": "backdrop",
    "transition": "handoff"
  },
  "params": {
    "rhythm.kick": 0.006,
    "layout.cap": 0.3,
    "background.table": 0.86,
    "background.light": 0.35,
    "background.floor": 0.25,
    "background.vignette": 0.7,
    "background.seam": 1,
    "material.shadow": 0.02,
    "transition.whoosh": 0
  },
  "defaults": {
    "palette": "card-table",
    "music": { "preset": "lofi-jazz", "bpm": 104 },
    "fonts": { "display": "rubik" }
  },
  "constraints": {
    "maxWordsPerSection": 5,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.2,
    "minTail": 0.6,
    "entry": 0.6,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
