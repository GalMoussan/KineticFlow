{
  "id": "bento",
  "name": "Bento",
  "families": ["dynamic-layout", "motion"],
  "energy": 3,
  "background": "light",
  "traits": {
    "rhythm": "land-kick",
    "camera": "static",
    "layout": "bento",
    "unit": "word",
    "reveal": "soft-rise",
    "motion": "smooth",
    "axis": "none",
    "material": "tile-ink",
    "background": "module-grid",
    "transition": "reflow"
  },
  "params": {
    "rhythm.kick": 0.004,
    "background.lines": 0,
    "background.dots": 0.6,
    "transition.whoosh": 0.35
  },
  "defaults": {
    "palette": "bento-pop",
    "music": { "preset": "minimal-pop", "bpm": 108 },
    "fonts": { "display": "rubik" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1.5,
    "leadIn": 0.15,
    "minTail": 0.6,
    "entry": 0.55,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "sketch",
    "width": 1,
    "rough": 0.15,
    "boil": false,
    "glow": 1,
    "drawBeats": 2,
    "ease": "functional",
    "exit": "fade",
    "pen": false,
    "color": "accent1",
    "layer": "over",
    "sfx": "scribble"
  }
}
