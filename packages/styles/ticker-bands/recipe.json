{
  "id": "ticker-bands",
  "name": "Ticker Bands",
  "families": ["scrolling", "high-energy"],
  "energy": 5,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "ticker-board",
    "unit": "word",
    "reveal": "band-lock",
    "motion": "snappy",
    "axis": "none",
    "material": "glow-tint",
    "background": "plain",
    "transition": "handoff"
  },
  "params": {
    "rhythm.kick": 0,
    "material.glow": 0,
    "transition.show": 0,
    "transition.hide": 0.55,
    "transition.whoosh": 0
  },
  "defaults": {
    "palette": "ticker-signal",
    "music": { "preset": "house-128", "bpm": 126 },
    "fonts": { "display": "rubik" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 0.5,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.2,
    "minTail": 0.85,
    "entry": 0.4,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "sketch",
    "width": 1.3,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 1,
    "ease": "snap",
    "exit": "stay",
    "pen": false,
    "color": "accent0",
    "layer": "over",
    "sfx": "pop"
  }
}
