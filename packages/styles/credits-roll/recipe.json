{
  "id": "credits-roll",
  "name": "Credits Roll",
  "families": ["scrolling", "narrative"],
  "energy": 2,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "credits-dolly",
    "layout": "credits-column",
    "unit": "word",
    "reveal": "credit-hold",
    "motion": "smooth",
    "axis": "none",
    "material": "glow-tint",
    "background": "plain",
    "transition": "camera-move"
  },
  "params": {
    "rhythm.kick": 0,
    "material.glow": 0,
    "transition.dip": 0,
    "transition.turnDip": 0,
    "layout.pitch": 0.92,
    "layout.share": 0.4,
    "layout.gone": 0.78,
    "camera.whoosh": 0.4
  },
  "defaults": {
    "palette": "credits-noir",
    "music": { "preset": "minimal-pop", "bpm": 120 },
    "fonts": { "display": "frank-ruhl-libre" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 0.5,
    "shortUnitBeats": 0.5,
    "moveBeats": 2,
    "leadIn": 0.45,
    "minTail": 0.7,
    "entry": 0.35,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "line",
    "width": 0.6,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 3,
    "ease": "smooth",
    "exit": "stay",
    "pen": false,
    "color": "text",
    "layer": "over",
    "sfx": "none"
  }
}
