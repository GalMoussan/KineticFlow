{
  "id": "width-breath",
  "name": "Width Breath",
  "families": ["variable-font", "fluid-typography", "simple"],
  "energy": 1,
  "background": "light",
  "traits": {
    "rhythm": "land-kick",
    "camera": "static",
    "layout": "flush-stack",
    "unit": "word",
    "reveal": "soft-rise",
    "motion": "smooth",
    "axis": "width-breath",
    "material": "glow-tint",
    "background": "liquid-blobs",
    "transition": "fade-push"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.align": 2,
    "layout.weight": 400,
    "layout.cap": 0.28,
    "layout.leading": 0.4,
    "reveal.lead": 0.2,
    "reveal.duration": 0.9,
    "reveal.rise": 0.08,
    "reveal.blur": 0.6,
    "axis.entry": 0.75,
    "background.strength": 0.22,
    "background.size": 1.1,
    "background.speed": 0.35,
    "transition.dip": 0.2,
    "transition.sound": 0.15
  },
  "defaults": {
    "palette": "breath-mist",
    "music": { "preset": "lofi-jazz", "bpm": 96 },
    "fonts": { "display": "noto-sans-hebrew" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.3,
    "minTail": 0.8,
    "entry": 0.7,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "line",
    "width": 0.8,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 3,
    "ease": "smooth",
    "exit": "fade",
    "pen": false,
    "color": "text",
    "layer": "over",
    "sfx": "none"
  }
}
