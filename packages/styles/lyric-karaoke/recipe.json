{
  "id": "lyric-karaoke",
  "name": "Lyric Karaoke",
  "families": [
    "beat-synced",
    "reveal"
  ],
  "energy": 2,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "fit-stack",
    "unit": "word",
    "reveal": "karaoke-sweep",
    "motion": "smooth",
    "axis": "none",
    "material": "karaoke-ink",
    "background": "plain",
    "transition": "cut"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.leading": 0.55,
    "layout.plain": 0.82,
    "layout.cap": 0.26,
    "layout.words": 2
  },
  "defaults": {
    "palette": "karaoke-dusk",
    "music": {
      "preset": "lofi-jazz",
      "bpm": 96
    },
    "fonts": {
      "display": "heebo"
    }
  },
  "constraints": {
    "maxWordsPerSection": 8,
    "formats": [
      "9:16",
      "1:1",
      "4:5",
      "16:9"
    ],
    "roles": [
      "title",
      "tagline",
      "body",
      "teaser",
      "cta",
      "heading",
      "question",
      "answer",
      "quote",
      "datetime",
      "location",
      "list",
      "stat",
      "countdown",
      "endcard",
      "lyric"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.5,
    "minTail": 0.8,
    "entry": 0.5,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
