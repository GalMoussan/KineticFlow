{
  "id": "glyph-morph",
  "name": "Glyph Morph",
  "families": ["morph", "motion"],
  "energy": 3,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "center-stack",
    "unit": "word",
    "reveal": "glyph-morph",
    "motion": "smooth",
    "axis": "none",
    "material": "flat",
    "background": "liquid-blobs",
    "transition": "cut"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.cap": 0.3,
    "layout.leading": 0.34,
    "material.swipes": 0,
    "background.strength": 0.3,
    "background.size": 1.1,
    "background.speed": 0.6
  },
  "defaults": {
    "palette": "midnight-ink",
    "music": { "preset": "lofi-jazz", "bpm": 104 },
    "fonts": { "display": "frank-ruhl-libre" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.1,
    "minTail": 0.7,
    "entry": 0.5,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "line",
    "width": 1,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 2,
    "ease": "smooth",
    "exit": "undraw",
    "pen": false,
    "color": "text",
    "layer": "over",
    "sfx": "scribble"
  }
}
