{
  "id": "chalkboard-cafe",
  "name": "Chalkboard Café",
  "families": ["textured"],
  "energy": 2,
  "background": "dark",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "center-stack",
    "unit": "word",
    "reveal": "chalk-write",
    "motion": "smooth",
    "axis": "none",
    "material": "chalk",
    "background": "chalkboard",
    "transition": "fade-push"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.cap": 0.36,
    "layout.plain": 0.7,
    "transition.dip": 0.6,
    "transition.sound": 0.25
  },
  "defaults": {
    "palette": "chalk-cafe",
    "music": { "preset": "lofi-jazz", "bpm": 100 },
    "fonts": { "display": "amatic-sc" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.2,
    "minTail": 0.6,
    "entry": 0.6,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "sketch",
    "width": 1.4,
    "rough": 0.7,
    "boil": true,
    "glow": 1,
    "drawBeats": 3,
    "ease": "functional",
    "exit": "undraw",
    "pen": false,
    "color": "text",
    "layer": "over",
    "sfx": "scribble"
  }
}
