{
  "id": "shape-to-type",
  "name": "Shape to Type",
  "families": [
    "morph",
    "motion"
  ],
  "energy": 3,
  "background": "light",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "center-stack",
    "unit": "word",
    "reveal": "shape-morph",
    "motion": "overshoot",
    "axis": "none",
    "material": "flat",
    "background": "shape-field",
    "transition": "cut"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.cap": 0.32,
    "material.swipes": 0,
    "background.strength": 0.4
  },
  "defaults": {
    "palette": "bauhaus-primary",
    "music": {
      "preset": "minimal-pop",
      "bpm": 112
    },
    "fonts": {
      "display": "rubik"
    }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": [
      "9:16",
      "1:1",
      "4:5",
      "16:9"
    ],
    "roles": [
      "title",
      "tagline",
      "body",
      "teaser",
      "cta",
      "heading",
      "question",
      "answer",
      "quote",
      "datetime",
      "location",
      "list",
      "stat",
      "countdown",
      "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.1,
    "minTail": 0.6,
    "entry": 0.45,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}