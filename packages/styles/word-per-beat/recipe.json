{
  "id": "word-per-beat",
  "name": "Word per Beat",
  "families": ["beat-synced", "high-energy"],
  "energy": 5,
  "background": "dark",
  "traits": {
    "rhythm": "land-kick",
    "camera": "static",
    "layout": "beat-stack",
    "unit": "word",
    "reveal": "beat-cut",
    "motion": "punchy",
    "axis": "none",
    "material": "beat-swap",
    "background": "plain",
    "transition": "cut"
  },
  "params": {
    "rhythm.kick": 0.018,
    "rhythm.decay": 12,
    "rhythm.length": 0.35,
    "motion.overshoot": 1.4
  },
  "defaults": {
    "palette": "beat-pop",
    "music": { "preset": "house-128", "bpm": 128 },
    "fonts": { "display": "heebo" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 1,
    "moveBeats": 0.5,
    "leadIn": 0.1,
    "minTail": 0.6,
    "entry": 0.5,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
