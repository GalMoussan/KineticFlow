{
  "id": "minimal-luxe",
  "name": "Minimal Luxe",
  "families": ["simple"],
  "energy": 1,
  "background": "light",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "luxe-frame",
    "unit": "grapheme",
    "reveal": "track-in",
    "motion": "smooth",
    "axis": "none",
    "material": "glow-tint",
    "background": "plain",
    "transition": "fade-push"
  },
  "params": {
    "rhythm.kick": 0,
    "reveal.duration": 1.1,
    "transition.dip": 1,
    "transition.push": 0,
    "transition.sound": 0.12
  },
  "defaults": {
    "palette": "luxe-bone",
    "music": { "preset": "lofi-jazz", "bpm": 96 },
    "fonts": { "display": "frank-ruhl-libre" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote", "datetime",
      "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.15,
    "minTail": 0.8,
    "entry": 0.9,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
