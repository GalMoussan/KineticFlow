{
  "id": "scramble-decode",
  "name": "Scramble Decode",
  "families": ["reveal", "generative"],
  "energy": 3,
  "background": "dark",
  "traits": {
    "rhythm": "land-kick",
    "camera": "static",
    "layout": "center-stack",
    "unit": "grapheme",
    "reveal": "scramble",
    "motion": "smooth",
    "axis": "none",
    "material": "glow-tint",
    "background": "screen",
    "transition": "flash-cut"
  },
  "params": {
    "rhythm.kick": 0.004,
    "material.glow": 0.6,
    "background.lines": 0.25,
    "background.grid": 0.7,
    "background.sweep": 0.6,
    "background.bloom": 0.35,
    "background.vignette": 0.6,
    "transition.flash": 0.3,
    "transition.decay": 22
  },
  "defaults": {
    "palette": "decode-cyan",
    "music": { "preset": "synthwave-drive", "bpm": 110 },
    "fonts": { "display": "heebo" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
        "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote", "datetime",
        "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.4,
    "minTail": 0.8,
    "entry": 0.8,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
