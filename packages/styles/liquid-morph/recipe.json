{
  "id": "liquid-morph",
  "name": "Liquid Morph",
  "families": [
    "morph",
    "fluid-organic"
  ],
  "energy": 2,
  "background": "light",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "center-stack",
    "unit": "word",
    "reveal": "liquid-morph",
    "motion": "smooth",
    "axis": "none",
    "material": "flat",
    "background": "liquid-blobs",
    "transition": "cut"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.cap": 0.3,
    "layout.leading": 0.32,
    "material.swipes": 0,
    "background.strength": 0.55,
    "background.size": 0.9,
    "background.speed": 0.8
  },
  "defaults": {
    "palette": "liquid-pastel",
    "music": {
      "preset": "lofi-jazz",
      "bpm": 100
    },
    "fonts": {
      "display": "fredoka"
    }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": [
      "9:16",
      "1:1",
      "4:5",
      "16:9"
    ],
    "roles": [
      "title",
      "tagline",
      "body",
      "teaser",
      "cta",
      "heading",
      "question",
      "answer",
      "quote",
      "datetime",
      "location",
      "list",
      "stat",
      "countdown",
      "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.1,
    "minTail": 0.8,
    "entry": 0.5,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "line",
    "width": 1.1,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 2.5,
    "ease": "smooth",
    "exit": "undraw",
    "pen": false,
    "color": "accent4",
    "layer": "over",
    "sfx": "scribble"
  }
}