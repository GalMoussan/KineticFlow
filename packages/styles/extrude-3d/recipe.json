{
  "id": "extrude-3d",
  "name": "Extrude 3D",
  "families": ["spatial", "motion"],
  "energy": 4,
  "background": "dark",
  "traits": {
    "rhythm": "land-kick",
    "camera": "orbit",
    "layout": "center-stack",
    "unit": "word",
    "reveal": "tilt-up",
    "motion": "overshoot",
    "axis": "none",
    "material": "extrude",
    "background": "backdrop",
    "transition": "handoff"
  },
  "params": {
    "rhythm.kick": 0.012,
    "camera.pitch": -10,
    "layout.leading": 0.5,
    "layout.cap": 0.5,
    "layout.plain": 0.72,
    "background.light": 0.7,
    "background.floor": 0.6,
    "transition.whoosh": 0.55
  },
  "defaults": {
    "palette": "bold-pop",
    "music": { "preset": "synthwave-drive", "bpm": 108 },
    "fonts": { "display": "rubik" }
  },
  "constraints": {
    "maxWordsPerSection": 5,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
      "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote",
      "datetime", "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1.5,
    "leadIn": 0.2,
    "minTail": 0.6,
    "entry": 0.6,
    "endUnitBeats": 1,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  },
  "sketch": {
    "presetMode": "sketch",
    "width": 1.8,
    "rough": 0,
    "boil": false,
    "glow": 1,
    "drawBeats": 1.5,
    "ease": "functional",
    "exit": "fade",
    "pen": false,
    "color": "accent0",
    "layer": "over",
    "sfx": "pop"
  }
}
