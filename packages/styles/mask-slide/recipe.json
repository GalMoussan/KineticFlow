{
  "id": "mask-slide",
  "name": "Mask Slide",
  "families": ["reveal", "simple"],
  "energy": 2,
  "background": "light",
  "traits": {
    "rhythm": "beat-pulse",
    "camera": "static",
    "layout": "flush-stack",
    "unit": "word",
    "reveal": "mask-slide",
    "motion": "functional",
    "axis": "none",
    "material": "glow-tint",
    "background": "plain",
    "transition": "panel-wipe"
  },
  "params": {
    "rhythm.kick": 0,
    "layout.align": 0,
    "layout.weight": 700,
    "layout.rule": 1,
    "layout.cap": 0.36,
    "layout.leading": 0.24,
    "layout.plain": 0.66,
    "motion.power": 2,
    "transition.panels": 0,
    "transition.blur": 0,
    "transition.push": 0.08
  },
  "defaults": {
    "palette": "editorial-light",
    "music": { "preset": "minimal-pop", "bpm": 96 },
    "fonts": { "display": "frank-ruhl-libre" }
  },
  "constraints": {
    "maxWordsPerSection": 6,
    "formats": ["9:16", "1:1", "4:5", "16:9"],
    "roles": [
        "title", "tagline", "body", "teaser", "cta", "heading", "question", "answer", "quote", "datetime",
        "location", "list", "stat", "countdown", "endcard"
    ]
  },
  "choreography": {
    "unitBeats": 1,
    "shortUnitBeats": 0.5,
    "moveBeats": 1,
    "leadIn": 0.3,
    "minTail": 0.8,
    "entry": 0.7,
    "endUnitBeats": 0.5,
    "endHold": 2.5,
    "introBeats": 0,
    "outroBeats": 0
  }
}
